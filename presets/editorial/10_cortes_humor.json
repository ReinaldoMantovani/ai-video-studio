{
  "schema_version": 1,
  "platforms": [
    "youtube_shorts",
    "tiktok",
    "instagram_reels"
  ],
  "aspect": "9:16",
  "resolution": {
    "width": 1080,
    "height": 1920
  },
  "fps": {
    "num": 30,
    "den": 1
  },
  "duration": {
    "min_s": null,
    "max_s": 180,
    "target_s": 40
  },
  "pacing": "dynamic",
  "cuts": {
    "remove_silence": true,
    "min_silence_ms": 500,
    "keep_padding_ms": 150,
    "preserve_silent_action": false,
    "remove_fillers": false,
    "max_shot_s": null,
    "rules": [
      "Nunca cortar o contexto necessário para a piada.",
      "Preservar a punchline e a reação."
    ]
  },
  "audio": {
    "loudness_lufs": -14.0,
    "true_peak_db": -1.0,
    "music_ducking_db": -12.0,
    "noise_reduction": true,
    "voice_priority": true
  },
  "captions": {
    "enabled": true,
    "style": "yellow_highlight",
    "position": "center_low",
    "max_chars_per_line": 42
  },
  "effects": {
    "allowed": [
      "zoom",
      "sound_fx",
      "meme_overlay"
    ],
    "intensity": "moderate"
  },
  "transitions": {
    "allowed": [
      "crossfade"
    ],
    "default_duration_ms": 400,
    "frequency": "rare"
  },
  "reframe": {
    "mode": "none",
    "keep_hud": false,
    "layouts": []
  },
  "narrative": {
    "mode": "best_moments",
    "hook_required": true,
    "rules": [
      "Inserir memes apenas quando relevantes."
    ]
  },
  "safety": {
    "safe_area": {
      "top_pct": 12,
      "bottom_pct": 22,
      "left_pct": 6,
      "right_pct": 14
    },
    "rules": [
      "Textos e legendas dentro da área segura; nunca atrás dos controles da plataforma.",
      "Não inventar falas, imagens ou acontecimentos.",
      "Não prometer resultados de visualizações."
    ]
  },
  "export_profile": "youtube_shorts",
  "scoring_weights": {
    "humor_signal": 0.25,
    "self_containment": 0.25,
    "reaction": 0.2,
    "semantic_relevance": 0.15,
    "technical_quality": 0.15
  },
  "id": "cortes_humor",
  "name": "Cortes de Humor",
  "category": "humor",
  "description": "Preserva a preparação e a punchline, detecta risadas e reações, com zooms pontuais e legendas expressivas."
}