{
  "schema_version": 1,
  "platforms": [
    "youtube_shorts",
    "tiktok",
    "youtube"
  ],
  "aspect": "9:16",
  "resolution": {
    "width": 1080,
    "height": 1920
  },
  "fps": {
    "num": 30,
    "den": 1
  },
  "duration": {
    "min_s": null,
    "max_s": 180,
    "target_s": 60
  },
  "pacing": "dynamic",
  "cuts": {
    "remove_silence": true,
    "min_silence_ms": 1500,
    "keep_padding_ms": 150,
    "preserve_silent_action": true,
    "remove_fillers": false,
    "max_shot_s": null,
    "rules": [
      "Remover períodos de espera quando irrelevantes.",
      "Priorizar trechos com contexto suficiente."
    ]
  },
  "audio": {
    "loudness_lufs": -14.0,
    "true_peak_db": -1.0,
    "music_ducking_db": -12.0,
    "noise_reduction": true,
    "voice_priority": true
  },
  "captions": {
    "enabled": true,
    "style": "bold_white",
    "position": "center_low",
    "max_chars_per_line": 42
  },
  "effects": {
    "allowed": [
      "zoom",
      "color_correction"
    ],
    "intensity": "subtle"
  },
  "transitions": {
    "allowed": [
      "crossfade"
    ],
    "default_duration_ms": 400,
    "frequency": "rare"
  },
  "reframe": {
    "mode": "facecam_gameplay",
    "keep_hud": true,
    "layouts": [
      "facecam_gameplay",
      "face_tracking",
      "fit_blur"
    ]
  },
  "narrative": {
    "mode": "best_moments",
    "hook_required": true,
    "rules": []
  },
  "safety": {
    "safe_area": {
      "top_pct": 12,
      "bottom_pct": 22,
      "left_pct": 6,
      "right_pct": 14
    },
    "rules": [
      "Textos e legendas dentro da área segura; nunca atrás dos controles da plataforma.",
      "Não inventar falas, imagens ou acontecimentos.",
      "Não prometer resultados de visualizações."
    ]
  },
  "export_profile": "youtube_shorts",
  "scoring_weights": {
    "reaction": 0.25,
    "semantic_relevance": 0.2,
    "self_containment": 0.2,
    "humor_signal": 0.15,
    "audio_intensity": 0.1,
    "technical_quality": 0.1
  },
  "id": "cortes_lives",
  "name": "Cortes de Lives",
  "category": "live",
  "description": "Analisa gravações longas para criar múltiplos cortes com reações, interações e momentos engraçados com contexto suficiente."
}