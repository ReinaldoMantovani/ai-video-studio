{
  "schema_version": 1,
  "platforms": [
    "youtube"
  ],
  "aspect": "16:9",
  "resolution": {
    "width": 1920,
    "height": 1080
  },
  "fps": null,
  "duration": {
    "min_s": null,
    "max_s": null,
    "target_s": 600
  },
  "pacing": "dynamic",
  "cuts": {
    "remove_silence": false,
    "min_silence_ms": 700,
    "keep_padding_ms": 150,
    "preserve_silent_action": true,
    "remove_fillers": false,
    "max_shot_s": 20,
    "rules": [
      "Selecionar melhores jogadas e picos de ação.",
      "Sincronizar cortes com a música quando houver trilha."
    ]
  },
  "audio": {
    "loudness_lufs": -14.0,
    "true_peak_db": -1.0,
    "music_ducking_db": -12.0,
    "noise_reduction": true,
    "voice_priority": true
  },
  "captions": {
    "enabled": false,
    "style": "clean_minimal",
    "position": "bottom",
    "max_chars_per_line": 42
  },
  "effects": {
    "allowed": [
      "zoom",
      "slow_motion",
      "text",
      "sound_fx"
    ],
    "intensity": "moderate"
  },
  "transitions": {
    "allowed": [
      "crossfade",
      "wipeleft",
      "slideleft"
    ],
    "default_duration_ms": 250,
    "frequency": "moderate"
  },
  "reframe": {
    "mode": "none",
    "keep_hud": false,
    "layouts": []
  },
  "narrative": {
    "mode": "best_moments",
    "hook_required": true,
    "rules": [
      "Slow motion moderado só quando apropriado.",
      "Textos curtos; não anunciar acontecimentos que não ocorrem."
    ]
  },
  "safety": {
    "safe_area": {
      "top_pct": 5,
      "bottom_pct": 5,
      "left_pct": 5,
      "right_pct": 5
    },
    "rules": [
      "Não inventar falas, imagens ou acontecimentos.",
      "Não prometer resultados de visualizações."
    ]
  },
  "export_profile": "youtube_1080p",
  "scoring_weights": {
    "visual_action": 0.3,
    "reaction": 0.2,
    "event_sequence": 0.2,
    "audio_intensity": 0.1,
    "self_containment": 0.1,
    "technical_quality": 0.1
  },
  "id": "gameplay_highlights",
  "name": "Gameplay Highlights",
  "category": "gameplay",
  "description": "Montagem dinâmica com as melhores jogadas, picos de ação, reações e momentos engraçados."
}