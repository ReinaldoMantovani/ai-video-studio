{
  "schema_version": 1,
  "platforms": [
    "youtube_shorts",
    "tiktok",
    "instagram_reels"
  ],
  "aspect": "9:16",
  "resolution": {
    "width": 1080,
    "height": 1920
  },
  "fps": {
    "num": 30,
    "den": 1
  },
  "duration": {
    "min_s": null,
    "max_s": 180,
    "target_s": 45
  },
  "pacing": "dynamic",
  "cuts": {
    "remove_silence": false,
    "min_silence_ms": 700,
    "keep_padding_ms": 150,
    "preserve_silent_action": true,
    "remove_fillers": false,
    "max_shot_s": null,
    "rules": []
  },
  "audio": {
    "loudness_lufs": -14.0,
    "true_peak_db": -1.0,
    "music_ducking_db": -12.0,
    "noise_reduction": true,
    "voice_priority": true
  },
  "captions": {
    "enabled": true,
    "style": "gaming_neon",
    "position": "center_low",
    "max_chars_per_line": 42
  },
  "effects": {
    "allowed": [
      "zoom",
      "color_correction"
    ],
    "intensity": "subtle"
  },
  "transitions": {
    "allowed": [
      "crossfade"
    ],
    "default_duration_ms": 400,
    "frequency": "rare"
  },
  "reframe": {
    "mode": "action_tracking",
    "keep_hud": true,
    "layouts": [
      "facecam_gameplay",
      "fit_blur",
      "center_crop"
    ]
  },
  "narrative": {
    "mode": "short_story",
    "hook_required": true,
    "rules": [
      "Criar vídeos curtos completos (começo, meio e fim).",
      "Preservar as reações do jogador."
    ]
  },
  "safety": {
    "safe_area": {
      "top_pct": 12,
      "bottom_pct": 22,
      "left_pct": 6,
      "right_pct": 14
    },
    "rules": [
      "Textos e legendas dentro da área segura; nunca atrás dos controles da plataforma.",
      "Não inventar falas, imagens ou acontecimentos.",
      "Não prometer resultados de visualizações."
    ]
  },
  "export_profile": "youtube_shorts",
  "scoring_weights": {
    "visual_action": 0.3,
    "reaction": 0.2,
    "event_sequence": 0.2,
    "audio_intensity": 0.1,
    "self_containment": 0.1,
    "technical_quality": 0.1
  },
  "id": "gameplay_vertical",
  "name": "Gameplay Vertical",
  "category": "gameplay",
  "description": "Converte gameplay horizontal para 9:16 mantendo a ação principal, HUD relevante e a facecam."
}