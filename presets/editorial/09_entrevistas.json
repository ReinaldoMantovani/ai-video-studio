{
  "schema_version": 1,
  "platforms": [
    "youtube"
  ],
  "aspect": "16:9",
  "resolution": {
    "width": 1920,
    "height": 1080
  },
  "fps": null,
  "duration": {
    "min_s": null,
    "max_s": null,
    "target_s": null
  },
  "pacing": "natural",
  "cuts": {
    "remove_silence": true,
    "min_silence_ms": 900,
    "keep_padding_ms": 250,
    "preserve_silent_action": false,
    "remove_fillers": false,
    "max_shot_s": null,
    "rules": [
      "Detectar entrevistador e entrevistado.",
      "Identificar mudanças de assunto."
    ]
  },
  "audio": {
    "loudness_lufs": -14.0,
    "true_peak_db": -1.0,
    "music_ducking_db": -12.0,
    "noise_reduction": true,
    "voice_priority": true
  },
  "captions": {
    "enabled": true,
    "style": "clean_minimal",
    "position": "bottom",
    "max_chars_per_line": 42
  },
  "effects": {
    "allowed": [
      "zoom",
      "color_correction"
    ],
    "intensity": "subtle"
  },
  "transitions": {
    "allowed": [
      "crossfade"
    ],
    "default_duration_ms": 400,
    "frequency": "rare"
  },
  "reframe": {
    "mode": "none",
    "keep_hud": false,
    "layouts": []
  },
  "narrative": {
    "mode": "preserve",
    "hook_required": false,
    "rules": [
      "Priorizar clareza e naturalidade.",
      "Preservar o contexto das respostas."
    ]
  },
  "safety": {
    "safe_area": {
      "top_pct": 5,
      "bottom_pct": 5,
      "left_pct": 5,
      "right_pct": 5
    },
    "rules": [
      "Não inventar falas, imagens ou acontecimentos.",
      "Não prometer resultados de visualizações."
    ]
  },
  "export_profile": "youtube_1080p",
  "scoring_weights": {
    "semantic_relevance": 0.25,
    "hook_strength": 0.2,
    "self_containment": 0.2,
    "expressiveness": 0.15,
    "pacing": 0.1,
    "technical_quality": 0.1
  },
  "id": "entrevistas",
  "name": "Entrevistas",
  "category": "talk",
  "description": "Remove pausas excessivas, destaca respostas importantes e preserva o contexto com cortes discretos."
}