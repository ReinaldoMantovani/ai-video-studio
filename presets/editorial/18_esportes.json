{
  "schema_version": 1,
  "platforms": [
    "youtube",
    "instagram_reels"
  ],
  "aspect": "16:9",
  "resolution": {
    "width": 1920,
    "height": 1080
  },
  "fps": null,
  "duration": {
    "min_s": null,
    "max_s": null,
    "target_s": null
  },
  "pacing": "dynamic",
  "cuts": {
    "remove_silence": false,
    "min_silence_ms": 700,
    "keep_padding_ms": 150,
    "preserve_silent_action": true,
    "remove_fillers": false,
    "max_shot_s": null,
    "rules": []
  },
  "audio": {
    "loudness_lufs": -14.0,
    "true_peak_db": -1.0,
    "music_ducking_db": -12.0,
    "noise_reduction": true,
    "voice_priority": true
  },
  "captions": {
    "enabled": false,
    "style": "clean_minimal",
    "position": "bottom",
    "max_chars_per_line": 42
  },
  "effects": {
    "allowed": [
      "slow_motion",
      "replay",
      "text",
      "zoom"
    ],
    "intensity": "moderate"
  },
  "transitions": {
    "allowed": [
      "crossfade"
    ],
    "default_duration_ms": 400,
    "frequency": "rare"
  },
  "reframe": {
    "mode": "none",
    "keep_hud": false,
    "layouts": []
  },
  "narrative": {
    "mode": "highlight_events",
    "hook_required": false,
    "rules": [
      "Preservar a sequência dos acontecimentos.",
      "Títulos de momentos apenas para o que ocorreu."
    ]
  },
  "safety": {
    "safe_area": {
      "top_pct": 5,
      "bottom_pct": 5,
      "left_pct": 5,
      "right_pct": 5
    },
    "rules": [
      "Não inventar falas, imagens ou acontecimentos.",
      "Não prometer resultados de visualizações."
    ]
  },
  "export_profile": "youtube_1080p",
  "scoring_weights": {
    "visual_action": 0.35,
    "reaction": 0.2,
    "event_sequence": 0.2,
    "audio_intensity": 0.15,
    "technical_quality": 0.1
  },
  "id": "esportes",
  "name": "Esportes",
  "category": "sports",
  "description": "Momentos de alta ação, comemorações, replays e slow motion contextual, preservando a sequência dos acontecimentos."
}