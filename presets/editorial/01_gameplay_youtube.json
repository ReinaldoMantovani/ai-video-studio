{
  "schema_version": 1,
  "platforms": [
    "youtube"
  ],
  "aspect": "16:9",
  "resolution": {
    "width": 1920,
    "height": 1080
  },
  "fps": null,
  "duration": {
    "min_s": null,
    "max_s": null,
    "target_s": null
  },
  "pacing": "natural",
  "cuts": {
    "remove_silence": false,
    "min_silence_ms": 700,
    "keep_padding_ms": 150,
    "preserve_silent_action": true,
    "remove_fillers": false,
    "max_shot_s": null,
    "rules": [
      "Eliminar telas de carregamento e menus sem relevância.",
      "Manter momentos de ação, vitórias, derrotas e acontecimentos inesperados.",
      "Nunca remover um trecho apenas por estar em silêncio."
    ]
  },
  "audio": {
    "loudness_lufs": -14.0,
    "true_peak_db": -1.0,
    "music_ducking_db": -14.0,
    "noise_reduction": false,
    "voice_priority": true
  },
  "captions": {
    "enabled": false,
    "style": "clean_minimal",
    "position": "bottom",
    "max_chars_per_line": 42
  },
  "effects": {
    "allowed": [
      "zoom",
      "sound_fx",
      "color_correction"
    ],
    "intensity": "subtle"
  },
  "transitions": {
    "allowed": [
      "crossfade",
      "dissolve"
    ],
    "default_duration_ms": 300,
    "frequency": "rare"
  },
  "reframe": {
    "mode": "none",
    "keep_hud": false,
    "layouts": []
  },
  "narrative": {
    "mode": "preserve",
    "hook_required": false,
    "rules": [
      "Preservar diálogos e reações do jogador.",
      "Zoom pontual apenas em acontecimentos importantes.",
      "Música sempre abaixo da narração."
    ]
  },
  "safety": {
    "safe_area": {
      "top_pct": 5,
      "bottom_pct": 5,
      "left_pct": 5,
      "right_pct": 5
    },
    "rules": [
      "Não inventar falas, imagens ou acontecimentos.",
      "Não prometer resultados de visualizações."
    ]
  },
  "export_profile": "youtube_1080p",
  "scoring_weights": {
    "visual_action": 0.3,
    "reaction": 0.2,
    "event_sequence": 0.2,
    "audio_intensity": 0.1,
    "self_containment": 0.1,
    "technical_quality": 0.1
  },
  "id": "gameplay_youtube",
  "name": "Gameplay YouTube",
  "category": "gameplay",
  "description": "Gameplay horizontal preservando a experiência original: remove carregamentos e trechos irrelevantes, mantém ação, diálogos e reações."
}