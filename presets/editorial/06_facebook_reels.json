{
  "schema_version": 1,
  "platforms": [
    "facebook_reels"
  ],
  "aspect": "9:16",
  "resolution": {
    "width": 1080,
    "height": 1920
  },
  "fps": {
    "num": 30,
    "den": 1
  },
  "duration": {
    "min_s": null,
    "max_s": 180,
    "target_s": 45
  },
  "pacing": "natural",
  "cuts": {
    "remove_silence": true,
    "min_silence_ms": 700,
    "keep_padding_ms": 150,
    "preserve_silent_action": false,
    "remove_fillers": false,
    "max_shot_s": null,
    "rules": []
  },
  "audio": {
    "loudness_lufs": -14.0,
    "true_peak_db": -1.0,
    "music_ducking_db": -12.0,
    "noise_reduction": true,
    "voice_priority": true
  },
  "captions": {
    "enabled": true,
    "style": "bold_white",
    "position": "center_low",
    "max_chars_per_line": 42
  },
  "effects": {
    "allowed": [
      "zoom",
      "color_correction"
    ],
    "intensity": "subtle"
  },
  "transitions": {
    "allowed": [
      "crossfade",
      "dissolve"
    ],
    "default_duration_ms": 400,
    "frequency": "moderate"
  },
  "reframe": {
    "mode": "none",
    "keep_hud": false,
    "layouts": []
  },
  "narrative": {
    "mode": "short_story",
    "hook_required": false,
    "rules": [
      "Contexto claro nos primeiros segundos.",
      "Preservar áreas de interface da plataforma."
    ]
  },
  "safety": {
    "safe_area": {
      "top_pct": 12,
      "bottom_pct": 22,
      "left_pct": 6,
      "right_pct": 14
    },
    "rules": [
      "Textos e legendas dentro da área segura; nunca atrás dos controles da plataforma.",
      "Não inventar falas, imagens ou acontecimentos.",
      "Não prometer resultados de visualizações."
    ]
  },
  "export_profile": "facebook_reels",
  "scoring_weights": {
    "semantic_relevance": 0.25,
    "hook_strength": 0.2,
    "self_containment": 0.2,
    "expressiveness": 0.15,
    "pacing": 0.1,
    "technical_quality": 0.1
  },
  "id": "facebook_reels",
  "name": "Facebook Reels",
  "category": "social_vertical",
  "description": "Vertical para consumo mobile: textos legíveis, contexto claro e legendas para assistir sem áudio."
}